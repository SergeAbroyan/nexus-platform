{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gitleaks version used by the secret scan in CI",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": ["GITLEAKS_VERSION: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Argo CD chart version in every environment",
      "managerFilePatterns": ["/^infrastructure/live/[^/]+/environment\\.hcl$/"],
      "matchStrings": [
        "chart_repository = \"(?<registryUrl>[^\"]+)\"\\n\\s+chart_version\\s+= \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Terraform version installed in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": ["terraform_version: (?<currentValue>\\S+)"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Terragrunt version installed in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": ["tg_version: (?<currentValue>\\S+)"],
      "depNameTemplate": "gruntwork-io/terragrunt",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "TFLint version installed in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": ["tflint_version: (?<currentValue>\\S+)"],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "groupName": "Terraform modules"
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider", "required_provider"],
      "groupName": "Terraform providers"
    },
    {
      "matchPackageNames": ["hashicorp/terraform", "gruntwork-io/terragrunt", "terraform-linters/tflint"],
      "groupName": "Infrastructure tools"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
