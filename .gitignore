# Terraform working directories
**/.terraform/*

# Terraform state contains infrastructure details and may contain secrets
*.tfstate
*.tfstate.*

# Local Terraform and Terragrunt variable files may contain secrets
*.tfvars
*.tfvars.json
*.hcl.local

# Local plan files
*.tfplan

# Terraform crash and diagnostic output
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terragrunt download cache
**/.terragrunt-cache/*

# Checkov's downloaded external-module cache
**/.external_modules/*

# Operating-system and editor files
.DS_Store
.idea/
.vscode/
*.swp

# Personal values for one deployment; the template is identity.example.hcl
infrastructure/live/identity.hcl
